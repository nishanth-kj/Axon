<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Axonandroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/axon_background</item>
        <item name="android:textColor">@color/axon_text</item>
        <item name="android:textColorHint">@color/axon_faint</item>
    </style>

    <style name="AxonLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/axon_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AxonField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/axon_text</item>
        <item name="android:textColorHint">@color/axon_faint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
